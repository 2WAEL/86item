rules_version = '2';

/*
  ============================================================================
  قواعد Firestore المحصّنة — مشروع item-f8564 (داشبورد الايتمات الموقوفة)
  ============================================================================
  المبدأ: كل عملية بتتحقق من (1) إن المستخدم مسجّل دخول، (2) إن ملفه الشخصي
  موجود ونشط، (3) إن دوره يسمح بالعملية دي.

  ملاحظة مهمة عن "قفل المدير":
  أول حساب يسجّل دخول في النظام هو مدير النظام (bootstrap). عشان ما حدش يقدر
  ياخد الرتبة دي بإغفال، الـ Rules بتسمح بإنشاء ملف "مدير نظام" بس لو المستخدم
  ماسك قفل التهيئة (system/adminLock) — والقفل ده أول واحد يعمله ياخده، وباقي
  المستخدمين لو حاولوا يعملوه هيقدروا ياخدوا قفل موجود مش ملكهم.

  أي collection مش مذكورة هنا → ممنوعة افتراضيًا (deny by default).
  ============================================================================
*/

service cloud.firestore {
  match /databases/{database}/documents {

    /* ======================= Helpers ======================= */

    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    // الملف الشخصي موجود؟
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(myEmail()));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(myEmail()));
    }

    // الحساب نشط (مش موقوف من الأدمن)
    function isActive() {
      return hasProfile() && myProfile().data.active == true;
    }

    function myRole() {
      return hasProfile() ? myProfile().data.role : '';
    }

    // مدير النظام (صلاحيات كاملة)
    function isAdmin() {
      return isActive() && myProfile().data.isAdmin == true;
    }

    // مانجمنت (إدارة) — مش لازم يكون مدير نظام
    function isManager() {
      return isActive() && myRole() == 'management';
    }

    // قائمة فروع اليوزر (فاضية لو مانجمنت)
    function myBranches() {
      return hasProfile() && myProfile().data.branches != null ? myProfile().data.branches : [];
    }

    function inMyBranches(branchKey) {
      return myBranches().hasAny([branchKey]);
    }

    // اليوزر ده مخول بالفرع ده؟
    function ownsBranch(branchKey) {
      return isActive() && (isManager() || inMyBranches(branchKey));
    }

    /* ======================= الملفات الشخصية ======================= */

    match /users/{userId} {
      // قراءة: صاحب الحساب نفسه + الأدمن + المانجمنت
      allow read: if signedIn() && (userId == myEmail() || isAdmin() || isManager());

      // ⚠️ إنشاء — حالتين بس:
      //  (أ) الأدمن/المانجمنت ينشئ حساب لحد تاني (من غير isAdmin)
      //  (ب) المستخدم الجديد ينشئ ملفه الأول لنفسه بس: موقوف + أقل صلاحية + من غير فروع
      //      (التسجيل الذاتي → الحساب بينتظر موافقة الإدارة)
      allow create: if (
        (isManager() && request.resource.data.isAdmin == false)
        || (
          userId == myEmail()
          && request.resource.data.active == false
          && request.resource.data.isAdmin == false
          && request.resource.data.role == 'agent'
          && (request.resource.data.branches == null || request.resource.data.branches.size() == 0)
        )
      );

      // تعديل:
      //  - الأدمن: أي حاجة
      //  - المانجمنت: يعدّل غيره بس من غير ما يدي isAdmin، ومن غير ما يصعّد نفسه
      allow update: if isAdmin() || (
        isManager()
        && request.resource.data.isAdmin == resource.data.isAdmin
        && (
          userId != myEmail()
          || (
            request.resource.data.role == resource.data.role
            && request.resource.data.branches == resource.data.branches
          )
        )
      );

      // حذف: الأدمن بس
      allow delete: if isAdmin();
    }

    /* ======================= إعدادات الأدوار ======================= */
    // تعريف الأدوار (مصدر واحد للحقيقة) — المانجمنت يقرأ، الأدمن بس يعدّل
    match /config/{docId} {
      allow read: if isManager();
      allow write: if isAdmin();
    }

    /* ======================= قفل تهيئة المدير ======================= */
    /* بقى بدون استخدام: مفيش تسجيل ذاتي خالص — الحسابات بتتعمل من ⚙️ إدارة المستخدمين */

    match /system/adminLock {
      allow read, write: if false;
    }

    /* ======================= المطاعم ======================= */

    match /restaurants/{docId} {
      allow read: if isActive();
      allow write: if isManager();
    }

    /* ======================= الفروع ======================= */

    match /branches/{docId} {
      allow read: if isActive() && (isManager() || inMyBranches(docId));
      allow write: if isManager();
    }

    /* ======================= المنيو ======================= */

    match /menu_items/{docId} {
      // branch == '' يعني صنف مشترك على مستوى المطعم
      allow read: if isActive() && (
        isManager() || resource.data.branch == '' || inMyBranches(resource.data.branch)
      );
      allow write: if isManager();
    }

    /* ======================= أسباب الإيقاف ======================= */

    match /reasons/{docId} {
      allow read: if isActive() && (
        isManager() || resource.data.branch == '' || inMyBranches(resource.data.branch)
      );
      allow write: if isManager();
    }

    /* ======================= سجلات الإيقاف ======================= */

    match /item_stoppages/{docId} {
      allow read: if isActive() && (isManager() || inMyBranches(resource.data.branch));
      // ملاحظة: في الإنشاء بيكون resource مش موجود — لازم نستخدم request.resource
      allow create: if isActive() && (isManager() || inMyBranches(request.resource.data.branch));
      allow update, delete: if isActive() && (isManager() || inMyBranches(resource.data.branch));
    }

    /* ======================= أوقات التحضير والتوصيل ======================= */

    match /branch_times/{docId} {
      allow read: if isActive() && (isManager() || inMyBranches(resource.data.branch));
      allow write: if isManager();
    }

    /* ======================= سجل الورديات ======================= */

    match /shift_log/{docId} {
      allow read: if isActive() && (isManager() || inMyBranches(resource.data.branch));
      allow write: if isManager();
    }

    /* ======================= سجل العمليات ======================= */

    match /audit_logs/{docId} {
      // العرض للأدمن بس — الكتابة مفتوحة لكل حساب نشط (التطبيق بيسجّل العمليات)
      allow read: if isAdmin();
      allow write: if isActive();
    }

    /* ======================= سجل الأخطاء ======================= */

    match /error_log/{docId} {
      allow read: if isAdmin();
      allow write: if isActive();
    }

    /* ======================= الإشعارات ======================= */

    match /notifications/{docId} {
      allow read: if isActive();
      allow write: if isActive();
    }

    /* ======================= افتراضي: ممنوع ======================= */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
